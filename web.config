<?xml version="1.0" encoding="utf-8"?>
<!-- IIS(Windows Server)—— 和 index.html 放在同一個資料夾就會生效。

     重點只有兩個:走 https,而且 index.html 不要被瀏覽器快取住。
     整個工具就是那一份 index.html,快取住的話,你換了新版,開網頁的人
     還是拿到舊的。 -->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".pdf" mimeType="application/pdf" />
    </staticContent>

    <!-- index.html 與登入設定:每次都先問伺服器有沒有變 -->
    <location path="index.html">
      <system.webServer>
        <httpProtocol>
          <customHeaders>
            <add name="Cache-Control" value="no-cache, must-revalidate" />
          </customHeaders>
        </httpProtocol>
      </system.webServer>
    </location>
    <location path="auth-config.js">
      <system.webServer>
        <httpProtocol>
          <customHeaders>
            <add name="Cache-Control" value="no-cache, must-revalidate" />
          </customHeaders>
        </httpProtocol>
      </system.webServer>
    </location>

    <!-- http 一律轉去 https。用 http 開的話登入會直接失敗(見 讀我.md) -->
    <rewrite>
      <rules>
        <rule name="force-https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
